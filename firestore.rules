rules_version = '2';

// What is allowed (client SDK, i.e. the PWA; the price job's Admin SDK bypasses these rules):
// - products/{asin}: anyone can read the list. Create and update only with the fields asin, name, targetPrice,
//   addedAt, archivedAt, where asin equals the document id, addedAt is a string and archivedAt is null or a string.
//   Delete is refused: "removing" a product in the PWA archives it (archivedAt), so the history is kept.
// - devices/{token}: nobody can read or delete. A client can only create or refresh its own registration, with the
//   fields createdAt and lastSeenAt set to the server time.
// Tradeoff: the PWA gate is only a client-side facade, so the product list can be written by anyone who has the
// public web config. Writes are limited to the expected fields and to the document id = asin.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{asin} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly(['asin', 'name', 'targetPrice', 'addedAt', 'archivedAt'])
        && request.resource.data.asin == asin
        && request.resource.data.addedAt is string
        && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is string);

      allow delete: if false;
    }

    match /devices/{token} {
      allow read, delete: if false;

      allow create: if request.resource.data.keys().hasOnly(['createdAt', 'lastSeenAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;

      allow update: if request.resource.data.keys().hasOnly(['createdAt', 'lastSeenAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSeenAt == request.time;
    }
  }
}
